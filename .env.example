# Copy to .env and fill in what you need. Never commit .env.
# With the defaults below DocMind runs fully offline (fake LLM + hashing embeddings).

# --- Providers -------------------------------------------------------------
# LLM_PROVIDER: fake | openai | anthropic | gemini
LLM_PROVIDER=fake
# EMBEDDING_PROVIDER: fake | openai | gemini   (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=fake

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- API -------------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header. Empty = auth disabled (dev only).
API_KEYS=dev-key
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Storage & RAG ---------------------------------------------------------
DATABASE_URL=sqlite:///./data/docmind.db
# chroma | memory
VECTOR_STORE=chroma
CHROMA_PATH=./data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MAX_UPLOAD_MB=20
